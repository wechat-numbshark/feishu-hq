# 生产部署环境变量示例（复制为 deploy/compose/.env 并填写强随机值）
# 生成：openssl rand -base64 32

POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
HQ_APP_PASSWORD=CHANGE_ME_STRONG_RANDOM
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_RANDOM
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_RANDOM
KODBOX_DB_PASSWORD=CHANGE_ME_STRONG_RANDOM
KODBOX_ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM

# 会话签名密钥：至少 32 位，且必须与所有 API 实例一致
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARS

# 公网访问地址（生产必须是 HTTPS 域名）
APP_BASE_URL=https://hq.example.com

# 生产默认关闭演示；确需公开 demo 才设为 true
DEMO_MODE=false
# 位于 nginx 之后为 true；直接暴露 API 时设 false
TRUST_PROXY=true
# HTTPS 生产必须 true；只有 HTTP 试用环境才设 false
COOKIE_SECURE=true
# 飞书 OAuth 回调（必须与飞书后台完全一致）
FEISHU_REDIRECT_URI=https://hq.example.com/v1/feishu/callback
# 额外允许的跨域来源（通常留空，同源即可）
CORS_ORIGINS=

# 可选：AI / 飞书
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# MODEL_PROVIDER=openai
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=
# MODEL_NAME=gpt-4o-mini
