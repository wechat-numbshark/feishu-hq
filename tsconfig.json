{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "strict": true,
    // 基线：启用大部分 strict（含 strictNullChecks）；noImplicitAny 暂关，
    // 因 pg 等未安装 @types 的依赖会产生大量 implicit-any 噪声，列为后续专项。
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["apps/api/src/**/*.ts", "apps/worker/src/**/*.ts", "modules/platform/src/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "apps/web"]
}
