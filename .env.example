# ── 运行环境
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# 演示登录：开发默认开启；生产默认关闭，必须显式 DEMO_MODE=true 才开放
DEMO_MODE=true
# 位于 nginx/反代之后设 true，直连设 false（决定是否信任 X-Forwarded-For）
TRUST_PROXY=false
# 生产默认 true（__Host- + Secure）；只有 HTTP 试用环境才设 false
# COOKIE_SECURE=true

# ── 会话安全（必填，至少 32 位随机字符）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_at_least_32_random_characters

# ── PostgreSQL（必填）
# 管理员用户（用于迁移）
DATABASE_URL=postgresql://hq_admin:change_me@localhost:5432/feishu_hq
POSTGRES_PASSWORD=change_me
# 应用用户（权限受限，用于 API/Worker 运行时）
HQ_APP_PASSWORD=change_me
# Worker 使用相同数据库，但可使用不同凭据
WORKER_DATABASE_URL=postgresql://hq_app:change_me@localhost:5432/feishu_hq

# ── MinIO 文件存储（可选）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=feishu_hq
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=attachments

# ── 飞书 OAuth（可选，不填时仅支持 Demo 登录）
# 1. 去 https://open.feishu.cn/app 创建企业自建应用
# 2. 将回调地址 http://your-domain/v1/feishu/callback 加入安全设置
# 3. 申请权限：contact:user.base:readonly contact:department.base:readonly
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ALLOW_FIRST_ADMIN=false

# ── AI 大模型（可选，支持 OpenAI / Anthropic / 本地 Ollama）
# OpenAI:  MODEL_PROVIDER=openai  MODEL_BASE_URL=https://api.openai.com/v1
# Claude:  MODEL_PROVIDER=anthropic  MODEL_BASE_URL=https://api.anthropic.com/v1
# Ollama:  MODEL_PROVIDER=ollama  MODEL_BASE_URL=http://localhost:11434/v1
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
# Encrypt tenant AI keys at rest (32+ chars; falls back to SESSION_SECRET if empty)
SETTINGS_ENCRYPTION_KEY=
# Monthly budget defaults (tenant; person overrides live in DB)
AI_DEFAULT_MONTHLY_TOKENS=2000000
AI_DEFAULT_MONTHLY_COST_MICROS=20000000
AI_INPUT_PRICE_PER_1M=2.5
AI_OUTPUT_PRICE_PER_1M=10

# ── 应用基础 URL（用于飞书卡片跳转链接、Origin 校验）
# 生产必须填公网 HTTPS 域名，例如 https://hq.example.com
APP_BASE_URL=http://localhost:3000

# ── 跨域（生产环境填写前端域名，逗号分隔；为空表示只允许同源）
CORS_ORIGINS=

# ── Worker 轮询间隔（毫秒）
WORKER_OUTBOX_INTERVAL=5000
WORKER_SNAPSHOT_INTERVAL=3600000

# ── Kodbox/可道云（可选，文件管理与 NAS）
# Kodbox 官方镜像仅支持 MySQL/SQLite 自动安装，使用 MySQL
KODBOX_DB_USER=kodbox
KODBOX_DB_PASSWORD=change_me
KODBOX_ADMIN_USER=admin
KODBOX_ADMIN_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
